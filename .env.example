# --- Submissions (server-side only) -------------------------------------------
# Fine-grained GitHub token with access to this repository only:
#   Repository permissions → Contents: Read and write, Pull requests: Read and write
#   (optional) Issues: Read and write, so PRs get "submission" labels
GITHUB_TOKEN=
GITHUB_OWNER=jirkacepelka
GITHUB_REPO=awesome-zima
GITHUB_BASE_BRANCH=main

# Optional Cloudflare Turnstile captcha. Leave both empty to disable.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Public site settings ------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://awesome-zima.vercel.app
NEXT_PUBLIC_REPO_URL=https://github.com/jirkacepelka/awesome-zima
NEXT_PUBLIC_REPO_BRANCH=main
