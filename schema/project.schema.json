{
  "title": "Awesome Zima project",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "tagline": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 3000
    },
    "category": {
      "type": "string",
      "enum": [
        "App",
        "App Store",
        "Tool",
        "Integration",
        "Guide",
        "Hardware",
        "Theme",
        "Other"
      ]
    },
    "tags": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "url": {
      "type": "string",
      "maxLength": 500,
      "format": "uri"
    },
    "repo": {
      "type": "string",
      "maxLength": 500,
      "format": "uri"
    },
    "docs": {
      "type": "string",
      "maxLength": 500,
      "format": "uri"
    },
    "icon": {
      "type": "string",
      "maxLength": 500,
      "format": "uri"
    },
    "screenshots": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "format": "uri"
      }
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "license": {
      "type": "string",
      "maxLength": 40
    },
    "zimaosVersion": {
      "type": "string",
      "maxLength": 20
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "beta",
        "archived"
      ]
    },
    "addedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "slug",
    "name",
    "tagline",
    "description",
    "category",
    "url",
    "author",
    "addedAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
